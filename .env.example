# Optional. When unset, the app uses the seed/mock adapter unless Solana is enabled.
# Point this at a running Robinhood Liquidity Terminal (read-only HTTP).
# Example: http://127.0.0.1:3000
TERMINAL_BASE_URL=

# Optional. Terminal cold snapshots can take several minutes.
TERMINAL_TIMEOUT_MS=120000

# Set true/1/yes to activate the Solana DexScreener discovery adapter.
# Mock-only and Terminal-only modes stay unchanged when this is unset.
SOLANA_MARKET_ENABLED=

# Optional override. Default: https://api.dexscreener.com
SOLANA_DEXSCREENER_BASE_URL=

# Optional DexScreener timeout in milliseconds. Default: 12000
SOLANA_TIMEOUT_MS=12000

# Optional pause between DexScreener/registry calls in milliseconds. Default: 50
SOLANA_REQUEST_GAP_MS=50

# Max concurrent DexScreener/registry requests. Default: 6
SOLANA_MAX_CONCURRENT=6

# Snapshot cache TTL in milliseconds. Default: 300000 (5 minutes)
SOLANA_CACHE_MS=300000

# DexScreener hydrate budget AFTER discovery (home/light). Default: 20000
# Search pairs are seeded even if this budget is 0; remaining mints keep hydrating in the background.
SOLANA_HOME_BUDGET_MS=25000

# DexScreener hydrate budget AFTER discovery (chain page / every-pool). Default: 60000
SOLANA_FULL_BUDGET_MS=60000

# Background DexScreener hydrate after the first snapshot is returned. Default: 180000
SOLANA_ENRICH_BUDGET_MS=180000

# Skip re-previewing mints confirmed to have zero DexScreener pools. Default: 1800000 (30 min)
SOLANA_EMPTY_CACHE_MS=1800000

# Live xStocks public registry (paginated). Default enabled.
# This is a candidate source, not an admission list — the classifier still gates.
SOLANA_XSTOCKS_REGISTRY_ENABLED=true
SOLANA_XSTOCKS_REGISTRY_URL=https://api.xstocks.fi/api/v2

# Public Ondo GM mint list (no API key). Candidate source, not an admission list.
# Official api.gm.ondo.finance is keyed and is not used.
SOLANA_ONDO_REGISTRY_ENABLED=true
SOLANA_ONDO_REGISTRY_URL=https://raw.githubusercontent.com/ondoprotocol/gm-solana-simulator/main/constants.rs

# Public Tessera PE T-Token mint list (no API key). Candidate source, not an admission list.
# Tessera V (Wintermute prop-AMM) is a different product and has no per-stock public volume feed.
SOLANA_TESSERA_REGISTRY_ENABLED=true
SOLANA_TESSERA_REGISTRY_URL=https://docs.tessera.pe/technicals/on-chain-programs.md

# Public Sunrise token list (no API key). Candidate source for Backpack Securities names, not an admission list.
# Classifier still requires the on-chain name to include "Backpack Securities". Pump.fun copycats fail closed.
SOLANA_SUNRISE_REGISTRY_ENABLED=true
SOLANA_SUNRISE_REGISTRY_URL=https://api.sunrise.xyz

# Public Jupiter token metadata (no API key). Mint-keyed logo fallback after DexScreener pair imageUrl.
# Never ticker-matched. HTTPS icon URLs only. Default: lite-api.jup.ag/tokens/v2
SOLANA_JUPITER_TOKEN_LOGOS_ENABLED=true
SOLANA_JUPITER_TOKEN_URL=https://lite-api.jup.ag/tokens/v2

# Jupiter Tokens V2 holderCount for the asset statistics card (the page mint only).
# The Markets table does not use this. Missing or failed responses stay a dash. Default enabled.
SOLANA_JUPITER_HOLDERS_ENABLED=true

# Markets Holders column: DexScreener pair-details holders.count for that pool's base token.
# LP-token counts are ignored (null on CLMM, DLMM, Whirlpool, and PumpSwap). A missing count stays a dash.
SOLANA_PAIR_HOLDERS_ENABLED=true
SOLANA_DEXSCREENER_IO_BASE_URL=https://io.dexscreener.com

# Solana JSON-RPC used only on the asset page for mint supply (`getTokenSupply` UI amount).
# Market cap and FDV are DEX median price × that supply. DexScreener pair marketCap/fdv are not used.
# Set SOLANA_MINT_SUPPLY_ENABLED=false to leave supply, market cap, and FDV blank.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MINT_SUPPLY_ENABLED=true

# Public GeckoTerminal pool search (no API key). Candidate + hydrate hint only; 24h volume stays DexScreener.
# Asset chart shape is the primary pool. 7D/30D all-markets headlines sum daily OHLCV across every pool.
# That fill resumes across Gecko 429s, writes partial progress, and says all-markets only when every pool resolved.
# GeckoTerminal is not used for the desk Daily Volume history.
SOLANA_GECKOTERMINAL_ENABLED=true
SOLANA_GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# Daily Volume chart: persisted DexScreener desk 24h snapshots (public + private + ETF/index).
# Days before this desk started recording have no series — past totals are not invented from GeckoTerminal.
# Headless upsert: SOLANA_MARKET_ENABLED=true npm run snapshot:volume (no Gecko backfill).
SOLANA_VOLUME_SNAPSHOT_DIR=data/volume-snapshots
SOLANA_VOLUME_HISTORY_CACHE_MS=1800000
