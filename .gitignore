# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local DexScreener snapshot experiments. Closed-day files are tracked:
# solana.json, robinhood.json, base.json, and bnb.json. solana-hourly.json is the
# compact hourly totals series the routine commits.
/data/volume-snapshots/*.json
!/data/volume-snapshots/solana-hourly.json
!/data/volume-snapshots/solana.json
!/data/volume-snapshots/robinhood.json
!/data/volume-snapshots/base.json
!/data/volume-snapshots/bnb.json
!/data/volume-snapshots/solana-asset-daily.json
!/data/volume-snapshots/robinhood-asset-daily.json
!/data/volume-snapshots/base-asset-daily.json
!/data/volume-snapshots/bnb-asset-daily.json

# Cached cross-pool Gecko daily volume. Rebuilt in the background.
/data/cache/
